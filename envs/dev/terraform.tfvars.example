# Copiar como terraform.tfvars (no se sube al repo) y completar.

ses_sender_email = "notificaciones@ejemplo.com"
admin_email      = "admin@ejemplo.com"

# Interruptores de costo para dev
single_nat_gateway         = true
enable_interface_endpoints = false
db_multi_az                = false
db_deletion_protection     = false

